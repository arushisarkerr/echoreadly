# EchoReadly environment variables
#
# Copy this file to `.env.local` and fill in values from the Supabase dashboard.
# Never commit real secrets. Service role keys must stay server-side only.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Public site URL used for metadata and absolute links.
# Example: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Supabase (public)
# -----------------------------------------------------------------------------

# Project URL from Supabase → Project Settings → API.
# Example: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key. Safe to expose in the browser.
# Used by browser and cookie-based SSR clients with Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase (server only)
# -----------------------------------------------------------------------------

# Service role key. NEVER expose to the browser or Client Components.
# Bypasses Row Level Security — use only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Supabase Storage
# -----------------------------------------------------------------------------

# Create a private Storage bucket named `pdfs` in the Supabase dashboard.
# Apply Storage migrations so RLS scopes objects to `{auth.uid()}/{fileId}.pdf`.
# Phase 4C uploads object keys into that bucket (no public URL is generated).

# -----------------------------------------------------------------------------
# OpenAI (server only)
# -----------------------------------------------------------------------------

# API key for document summarization, chat, and TTS (required at runtime).
# Never expose to the browser or Client Components.
OPENAI_API_KEY=

# Gemini API key — used automatically for summarization when OpenAI returns
# 429 / rate limit / quota / temporary unavailability.
# Create at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# Optional store override: memory | supabase
# Default: memory in development, shared Supabase counters in production.
# Apply migration 20260730190000_rate_limit_counters.sql for production.
# RATE_LIMIT_STORE=

# -----------------------------------------------------------------------------
# Supabase Auth
# -----------------------------------------------------------------------------

# Enable Email provider and Google OAuth in Supabase → Authentication → Providers.
# Add redirect URL: {NEXT_PUBLIC_APP_URL}/auth/callback

# -----------------------------------------------------------------------------
# PDFium text extraction (server only)
# -----------------------------------------------------------------------------

# Requires Node.js runtime (not Edge). Validate with: npm run check:pdfium
# See docs/PDFIUM.md for Local / Docker / Vercel / VPS compatibility.
#
# Phase 2 geometry spacing: minimum gap/fontSize to insert U+0020 (default 0.5).
# Only applies at PDFium-generated space candidate sites; grapheme clusters are protected.
# PDFIUM_SPACE_THRESHOLD=0.5

# Max |Δy|/fontSize to treat characters as the same line (default 0.5).
# PDFIUM_LINE_TOLERANCE=0.5

# -----------------------------------------------------------------------------
# Mistral OCR (server only, optional — not a launch feature)
# -----------------------------------------------------------------------------

# Optional experimental fallback when PDFium finds no extractable text.
# Scanned / image-only PDFs are not supported in this launch unless this key
# is set and OCR succeeds. Prefer uploading text-based PDFs.
# Create at https://console.mistral.ai/
# Never expose to the browser or Client Components.
# MISTRAL_API_KEY=
